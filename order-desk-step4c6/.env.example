# Local-only template. scripts/init_env.py creates/extends the private .env.
# Preserve the original bootstrap password for an existing PostgreSQL volume.
POSTGRES_DB=orderdesk
POSTGRES_USER=orderdesk_dev_admin
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# Migration owner and restricted API role use separate random passwords.
DATABASE_MIGRATION_USER=orderdesk_migrator
DATABASE_MIGRATION_PASSWORD=
DATABASE_APP_USER=orderdesk_app
DATABASE_APP_PASSWORD=

DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
API_PORT=8000
